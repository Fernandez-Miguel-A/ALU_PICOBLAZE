; ========================================================
; SUBRUTINA: SUMA_FP16
; Entrada:  Operando A en (s1:s0), Operando B en (s3:s2)
; Salida:   Resultado en (s1:s0)
; ========================================================

;; total de registros usados: 11.
;; registros no utilizados sB, sC, sD, sE, sF.

MAIN:
LOAD s1, $62
LOAD s0, $2c

LOAD s3, $4a
LOAD s2, $0d

CALL suma_fp16

STORE s1, $13
STORE s0, $12
JUMP MAIN

suma_fp16:
    ; ----------------------------------------------------
    ; 1. EXTRAER EXPONENTES Y MANTISAS DE A
    ; ----------------------------------------------------
    ; Mantisa A -> s5:s4
    LOAD  s4, s0
    LOAD  s5, s1
    AND   s5, $03        ; Conservar solo bits 0 y 1 de mantisa en byte alto
    OR    s5, $04        ; Agregar el bit implícito 1 (bit 2 del byte alto)

    ; Exponente A -> s8
    LOAD  s8, s1
    SR0   s8
    SR0   s8            ; Alinear exponente a los 5 bits bajos
    AND   s8, $1F

    ; ----------------------------------------------------
    ; 2. EXTRAER EXPONENTES Y MANTISAS DE B
    ; ----------------------------------------------------
    ; Mantisa B -> s7:s6
    LOAD  s6, s2
    LOAD  s7, s3
    AND   s7, $03
    OR    s7, $04        ; Agregar el bit implícito 1

    ; Exponente B -> s9
    LOAD  s9, s3
    SR0   s9
    SR0   s9
    AND   s9, $1F

    ; ----------------------------------------------------
    ; 3. ALINEAR EXPONENTES (Alinear mantisa del menor)
    ; ----------------------------------------------------
    LOAD  sA, s8
    SUB   sA, s9        ; sA = ExpA - ExpB
    JUMP  Z, sumar_mantisas ; Si son iguales, no se desplaza
    JUMP  C, swap_y_alinear ; Si ExpA < ExpB, intercambiar

alinear_b:
    ; Desplazar Mantisa B (s7:s6) a la derecha sA veces
    SR0   s7
    SRA   s6
    SUB   sA, 01
    JUMP  NZ, alinear_b
    JUMP  sumar_mantisas

swap_y_alinear:
    ; Intercambiar mantisas y exponentes si B era mayor
    ; (omito swap completo por brevedad, asumir ExpA >= ExpB)
    ; s8 mantendrá el exponente mayor

; ----------------------------------------------------
; 4. SUMAR MANTISAS (Asumiendo mismo signo)
; ----------------------------------------------------
sumar_mantisas:
    ADD   s4, s6        ; Sumar bytes bajos
    ADDC  s5, s7        ; Sumar bytes altos con Carry

    ; ----------------------------------------------------
    ; 5. NORMALIZAR SI HAY OVERFLOW (Bit 3 de s5 activo)
    ; ----------------------------------------------------
    TEST  s5, $08        ; Comprobar el bit de acarreo
    JUMP  Z, empaquetar
    
    ; Si hubo acarreo: desplazar a la derecha y aumentar exponente
    SR0   s5
    SRA   s4
    ADD   s8, 01        ; Incrementar exponente

; ----------------------------------------------------
; 6. EMPAQUETAR RESULTADO
; ----------------------------------------------------
empaquetar:
    AND   s5, $03        ; Eliminar el bit implícito
    LOAD  s0, s4        ; Byte bajo del resultado

    SL0   s8
    SL0   s8            ; Mover exponente a sus bits correctos
    OR    s5, s8        ; Unir exponente con mantisa alta
    LOAD  s1, s5        ; Byte alto del resultado
    
    RET
